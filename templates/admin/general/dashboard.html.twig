{% extends 'base.html.twig' %}

{% block title %}Tableau de bord | Administration Famille Jean{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('style/css-prefixed/admin/general/dashboard.css') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,500&family=Work+Sans:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
    <main>
        <aside class="sidebar">

            <div class="sidebar-logo">
                <svg viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22 14c-5-6-14-4-14 3 0 9 14 13 14 13s14-4 14-13c0-7-9-9-14-3z" fill="none" stroke="#D94574" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M22 30 C22 42, 12 42, 8 48 C4 54, 30 54, 42 48 C54 42, 60 30, 74 32" fill="none" stroke="#D94574" stroke-width="3" stroke-linecap="round"/>
                </svg>

                <div class="sidebar-logo__text">
                    <span>Famille Jean</span>
                    <span>Administration</span>
                </div>
            </div>

            <div class="sidebar-label">Vue d'ensemble</div>

            <a href="{{ path('admin_dashboard') }}" class="sidebar-link active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="1.5"/>
                    <rect x="14" y="3" width="7" height="5" rx="1.5"/>
                    <rect x="14" y="12" width="7" height="9" rx="1.5"/>
                    <rect x="3" y="16" width="7" height="5" rx="1.5"/>
                </svg>

                Tableau de bord
            </a>

            <div class="sidebar-label">Gestion</div>

            <a href="{{ path('admin_members_list') }}" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>

                Membres
                <span class="badge-count">{{ all_members|length }}</span>
            </a>

            <a href="#" class="sidebar-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="3"/>
                    <path d="M16 2v4M8 2v4M3 10h18"/>
                </svg>

                Évènements
                <span class="badge-count">0</span>
            </a>


            <div class="sidebar-bottom">

                <div class="sidebar-user">
                    <div class="avatar">{{ app.user.adminName|first|upper }}</div>

                    <div class="who">
                        <strong>{{ app.user.adminName }}</strong>
                        <span>Administrateur</span>
                    </div>
                </div>

                <a href="{{ path('admin_logout') }}" class="sidebar-logout">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <path d="M16 17l5-5-5-5"/>
                        <path d="M21 12H9"/>
                    </svg>

                    Déconnexion
                </a>
            </div>
        </aside>


        <section>

            <div class="topbar">
                <div class="greeting">
                    Bonjour <strong>{{ app.user.adminName }}</strong> - <span>heureux de te revoir</span>
                </div>

                <a href="{{ path('admin_logout') }}" class="logout-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <path d="M16 17l5-5-5-5"/>
                        <path d="M21 12H9"/>
                    </svg>

                    <span>Déconnexion</span>
                </a>
            </div>

            <div class="section-content">

                <div class="page-title">
                    <span>Vue d'ensemble</span>

                    <h1>Bienvenue sur votre <em>tableau de bord</em></h1>
                </div>

                <div class="statistics">

                    <div class="stat-card">

                        <div class="icon-wrapper">
                            <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                        </div>

                        <div class="num">{{ all_members|length }}</div>
                        <div class="lbl">Membres recensés</div>
                    </div>

                    <div class="stat-card">

                        <div class="icon-wrapper">
                            <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="3"/>
                                <path d="M16 2v4M8 2v4M3 10h18"/>
                            </svg>
                        </div>

                        <div class="num">0</div>
                        <div class="lbl">Évènements à venir</div>
                    </div>

                    <div class="stat-card">

                        <div class="icon-wrapper">
                            <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                            </svg>
                        </div>

                        <div class="num">{{ members_of_this_month_counter }}</div>
                        <div class="lbl">Nouveaux ce mois</div>
                    </div>

                    <div class="stat-card">

                        <div class="icon-wrapper">
                            <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2 3 7v6c0 5.5 3.8 9.7 9 11 5.2-1.3 9-5.5 9-11V7l-9-5z"/>
                            </svg>
                        </div>

                        <div class="num">8</div>
                        <div class="lbl">Départements actifs</div>
                    </div>
                </div>

                <div class="panels-container">

                    <div class="panel-card">
                        <h2>Accès rapides</h2>

                        <div class="quick-list">

                            <a href="{{ path('admin_members_list') }}" class="quick-row">
                                <div class="icon-wrapper">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                        <circle cx="9" cy="7" r="4"/>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                                    </svg>
                                </div>

                                <div class="text">
                                    <strong>Liste des membres</strong>
                                    <span>Consulter, rechercher et gérer le registre</span>
                                </div>

                                <div class="arrow">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <path d="M5 12h14M13 6l6 6-6 6"/>
                                    </svg>
                                </div>
                            </a>


                            <a href="#" class="quick-row" title="create an event">
                                <div class="icon-wrapper">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="3"/>
                                        <path d="M16 2v4M8 2v4M3 10h18"/>
                                        <path d="M12 14v4M10 16h4"/>
                                    </svg>
                                </div>

                                <div class="text">
                                    <strong>Créer un évènement</strong>
                                    <span>Planifier une rencontre et notifier la famille</span>
                                </div>

                                <div class="arrow">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                        <path d="M5 12h14M13 6l6 6-6 6"/>
                                    </svg>
                                </div>
                            </a>
                        </div>
                    </div>

                    <div class="panel-card">
                        <h2>Activité récente</h2>

                        {% for activity in recents_activities %}
                            <div class="activity-list">
                                <div class="activity-item">

                                    <div class="dot-wrap">
                                        <div class="a-dot"></div>
                                        <div class="a-line"></div>
                                    </div>

                                    {# Gestion du libellé selon le type #}
                                    <div class="a-text">
                                        <p>
                                            {% if activity.type == 'USER_REGISTERED' %}
                                                <strong>{{ activity.title }}</strong> a rejoint la famille
                                            {% elseif activity.type == 'EVENT_CREATED' %}
                                                Évènement <strong>« {{ activity.title }} »</strong> créé
                                            {% else %}
                                                {{ activity.title }}
                                            {% endif %}
                                        </p>

                                        {# Affichage de la date formatée #}
                                        <span>{{ activity.createdAt|activity_date }}</span>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <p>Aucune activité récente.</p>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </section>
    </main>

{% endblock %}
