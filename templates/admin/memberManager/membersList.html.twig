{% extends 'base.html.twig' %}

{% block title %}Liste des membres | Administration Famille Jean{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/admin/membersManager/memberDetailsManager.js') }}" defer></script>
{% endblock %}

{% block body %}
    <h1>Liste des membres</h1>

    {% for member in members %}
        <div>
            <p>
                <span>{{ member.lastName }}</span><br >

                <a href="" class="member_details_link"
                   data-profile-pic="{% if member.profilePicture %}{{ asset('members/uploads/profile_pictures/' ~ member.profilePicture) }}{% endif %}"
                   data-pseudonyme="{{ member.pseudonyme }}"
                >
                    Details du membre
                </a>
            </p>

        </div>
    {% endfor %}


    <div id="modal-backdrop"></div>
    <div id="modal-container" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background-color: white; padding: 20px; border: 1px solid black; z-index: 2;">
        <div id="modal-profile-picture"></div>

        <h1 id="modal-member-pseudo"></h1>
    </div>
{% endblock %}

{% block stylesheets %}
    <style>
        #modal-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1;
            backdrop-filter: blur(3px);
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.25s ease;
        }
        #modal-backdrop.active {
            opacity: 1;
            visibility: visible;
        }
    </style>
{% endblock %}
