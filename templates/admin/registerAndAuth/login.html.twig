{% extends 'base.html.twig' %}

{% block title %}Se connecter{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('style/css-prefixed/admin/registerAndAuth/login.css') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,500&family=Work+Sans:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/member/showHidePasswordManager/showHidePasswordManager.js') }}" defer></script>
{% endblock %}

{% block body %}
    {# message if an account has been created but auth. failed #}
    {% for authenticationFailedMsg in app.flashes('authentication_error') %}
        <span>{{ authenticationFailedMsg }}</span>
    {% endfor %}

    <header>
        <nav>

            <div class="nav-logo">
                <svg viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22 14c-5-6-14-4-14 3 0 9 14 13 14 13s14-4 14-13c0-7-9-9-14-3z" fill="none" stroke="#D94574" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M22 30 C22 42, 12 42, 8 48 C4 54, 30 54, 42 48 C54 42, 60 30, 74 32" fill="none" stroke="#D94574" stroke-width="3" stroke-linecap="round"/>
                </svg>

                <div class="logo-text">
                    <span>Famille Jean</span>
                    <span>Administration</span>
                </div>
            </div>

            <a href="#" class="nav-back" onclick="history.back();">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3">
                    <path d="M19 12H5M12 19l-7-7 7-7"/>
                </svg>

                Retour
            </a>
        </nav>
    </header>

    <main>
        <div class="main-content">
            <div class="badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2 3 7v6c0 5.5 3.8 9.7 9 11 5.2-1.3 9-5.5 9-11V7l-9-5z"/>
                </svg>

                Accès administrateur
            </div>

            <h1 class="main-title">Connexion à l'administration</h1>

            <p class="subtitle">Identifie-toi pour accéder au registre des membres et aux outils de gestion.</p>

            <form method="post">
                {% if error %}
                    <div class="error">
                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 8v4M12 16h.01"/>
                        </svg>

                        <div>
                            <strong>Connexion impossible</strong>
                            <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                        </div>
                    </div>
                {% endif %}


                <div class="field">
                    <label for="inputAdminName">Nom d'administration</label>
                    <input type="text" value="{{ last_username }}" name="adminName" id="inputAdminName" class="form-control" autocomplete="username" required placeholder="Ex. : jean">
                </div>

                <div class="field">
                    <label for="inputPassword">Mot de passe</label>

                    <div class="field-password-wrapper">
                        <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required placeholder="Ex. : Ton mot de passe">

                        <button type="button" class="btn-toggle-password js-toggle-password" aria-label="Afficher le mot de passe" aria-pressed="false">
                            <svg class="js-eye-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <label class="remember-me">
                    <input type="checkbox" name="_remember_me">
                    <span>Se souvenir de moi</span>
                </label>

                <button class="submit-btn" type="submit">
                    Se connecter

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path d="M5 12h14M13 6l6 6-6 6"/>
                    </svg>
                </button>
            </form>


            <div class="foot-link">
                Pas encore de compte ? <a href="{{ path('admin_registration') }}">S'enregistrer</a>
            </div>
        </div>
    </main>
{% endblock %}
