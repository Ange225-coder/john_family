{% extends 'base.html.twig' %}

{% block title %}Famille Jean - ICC Deux Plateaux{% endblock %}

{% block body %}
    {# message if a last name, first name has been changed #}
    {% for informationSavedMsg in app.flashes('information_saved') %}
        {{ informationSavedMsg }}
    {% endfor %}

    <h1>Bienvenue dans la Famille des Intimes.</h1>

    {% if app.user %}
        <div>
            <a href="{{ path('member_settings') }}">Paramètres</a>
            <a href="{{ path('member_logout') }}" style="color: red">Déconnexion</a>
        </div>
    {% else %}
        <a href="{{ path('member_registration_step_one') }}">Devenir membre</a> <br >
        <a href="{{ path('member_login') }}">Se connecter</a>
    {% endif %}

{% endblock %}
