{% extends 'base.html.twig' %}

{% block title %}Famille Jean - ICC Deux Plateaux | Espace membre{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('style/css-prefixed/member/general/memberSpace.css') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,500&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
    <header>
        <nav>
            <div class="logo">
                <svg viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                    <path d="M22 14c-5-6-14-4-14 3 0 9 14 13 14 13s14-4 14-13c0-7-9-9-14-3z" fill="none" stroke="#A8235A" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M22 30 C22 42, 12 42, 8 48 C4 54, 30 54, 42 48 C54 42, 60 30, 74 32" fill="none" stroke="#A8235A" stroke-width="3" stroke-linecap="round"/>
                </svg>

                <span>Famille Jean</span>
            </div>

            <div class="nav-right">
                <a href="{{ path('member_logout') }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <path d="M16 17l5-5-5-5"/>
                        <path d="M21 12H9"/>
                    </svg>

                    <span>Déconnexion</span>
                </a>

                <div class="letter-pseudo">
                  {{ app.user.pseudonyme|first|upper }}
                </div>
            </div>
        </nav>
    </header>


    <section class="welcome">
        <div class="text">
            <span class="eyebrow">Espace membre</span>

            <h1>Bienvenue dans ton espace, <br >
                <span>{{ app.user.pseudonyme }}</span></h1>

            <p>Voici l'essentiel de la vie de la Famille Jean</p>
        </div>

        <div class="avatar">
            <div class="pseudo-letter">
                {{ app.user.pseudonyme|first|upper }}
            </div>

            <p class="avatar-details">
                <span>{{ app.user.pseudonyme }}</span>
                <span>Membre depuis {{ app.user.createdAt|date('F')|trans }} {{ app.user.createdAt|date('Y') }}</span>
            </p>
        </div>
    </section>


    <div class="statistic">
        <div class="stat-item">
            <div class="icon-wrapper">
                <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </div>
            <div>

                {% if all_members|length > 0 %}
                    <p class="stat-number">{{ all_members|length }}</p>

                    <p class="stat-label">Membres recensés</p>
                {% else %}
                    <p class="stat-number">0</p>

                    <p class="stat-label">Membres recensés</p>
                {% endif %}
            </div>
        </div>

        <div class="stat-item">
            <div class="icon-wrapper">
                <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="3"/>
                    <path d="M16 2v4M8 2v4M3 10h18"/>
                </svg>
            </div>

            <p class="stat-number">0</p>

            <p class="stat-label">Événements à venir</p>
        </div>

        <div class="stat-item">
            <div class="icon-wrapper">
                <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
            </div>

            <p class="stat-number">{{ members_of_this_month_counter }}</p>

            <p class="stat-label">Nouveaux ce mois</p>
        </div>

        <div class="stat-item">
            <div class="icon-wrapper">
                <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                </svg>
            </div>

            <p class="stat-number">0</p>

            <p class="stat-label">Notifications</p>
        </div>
    </div>


    <div class="rapid-access">
        <h1 class="wrapper-label">Accès rapides</h1>

        <div class="rapid-access__content">

            <div class="rapid-access__card">
                <div class="icon-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                </div>

                <h2>Mon profil</h2>

                <p class="card-details">Mets à jour tes informations personnelles et ta photo</p>

                <a href="#">
                    <span>Modifier</span>

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="16" height="16">
                        <path d="M5 12h14M13 6l6 6-6 6"/>
                    </svg>
                </a>
            </div>

            <div class="rapid-access__card">
                <div class="icon-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>

                <h2>Annuaire des membres</h2>

                <p class="card-details">Retrouve et recontact les membres de la famille</p>

                <a href="#">
                    <span>Parcourir</span>

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="16" height="16">
                        <path d="M5 12h14M13 6l6 6-6 6"/>
                    </svg>
                </a>
            </div>

            <div class="rapid-access__card">
                <div class="icon-wrapper">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="3"/>
                        <path d="M16 2v4M8 2v4M3 10h18"/>
                    </svg>
                </div>

                <h2>Événements</h2>

                <p class="card-details">Consulte les prochaines rencontres et confirme ta presence</p>

                <a href="#">
                    <span>Voir l'agenda</span>

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="16" height="16">
                        <path d="M5 12h14M13 6l6 6-6 6"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>


{#    <div class="verse-container">#}
{#        <p>&laquo; Bien-aimés, aimons-nous les uns les autres ; car l'amour est de Dieu. &raquo;</p>#}

{#        <p class="ref">1 jean 4:7</p>#}
{#    </div>#}


    <footer>
        <p>Famille Jean</p>
        <p>Impact Centre Chrétien — Deux Plateaux, Abidjan</p>
    </footer>
{% endblock %}
