{% extends 'base.html.twig' %}

{% block title %}Famille Jean - ICC Deux Plateaux | Paramètres{% endblock %}

{% block body %}
    <h1>Paramètres</h1>

    <div>
        <h2>Modifier votre nom</h2>

        {{ form_start(last_name_form) }}
            <div>
                {{ form_label(last_name_form.currentLastName) }}<br >
                {{ form_widget(last_name_form.currentLastName) }}
                {{ form_errors(last_name_form.currentLastName) }}
            </div>

            <div>
                {{ form_label(last_name_form.newLastName) }}<br >
                {{ form_widget(last_name_form.newLastName) }}
                {{ form_errors(last_name_form.newLastName) }}
            </div>

            <button type="submit">Modifier votre nom</button>
        {{ form_end(last_name_form) }}
    </div>


    <div>
        <h2>Modifier votre prénom</h2>

        {{ form_start(first_name_form) }}
            <div>
                {{ form_label(first_name_form.currentFirstName) }}<br >
                {{ form_widget(first_name_form.currentFirstName) }}
                {{ form_errors(first_name_form.currentFirstName) }}
            </div>

            <div>
                {{ form_label(first_name_form.newFirstName) }}<br >
                {{ form_widget(first_name_form.newFirstName) }}
                {{ form_errors(first_name_form.newFirstName) }}
            </div>

            <button type="submit">Modifier votre prénom</button>
        {{ form_end(first_name_form) }}
    </div>


    <div>
        <h2>Modifier votre pseudonyme</h2>

        {{ form_start(pseudonyme_form) }}
            <div>
                {{ form_label(pseudonyme_form.currentPseudonyme) }}<br >
                {{ form_widget(pseudonyme_form.currentPseudonyme) }}
                {{ form_errors(pseudonyme_form.currentPseudonyme) }}
            </div>

            <div>
                {{ form_label(pseudonyme_form.newPseudonyme) }}<br >
                {{ form_widget(pseudonyme_form.newPseudonyme) }}
                {{ form_errors(pseudonyme_form.newPseudonyme) }}
            </div>

            <button type="submit">Modifier votre pseudonyme</button>
        {{ form_end(pseudonyme_form) }}
    </div>

{% endblock %}
