{% extends 'base.html.twig' %}

{% block title %}Famille Jean - ICC Deux Plateaux | Devenir membre{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('style/css-prefixed/member/registerAndAuth/registrationStepTwo.css') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,500&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/member/registerAndAuth/registrationStepTwoPasswordShowManager.js') }}" defer></script>
    <script src="{{ asset('js/member/registerAndAuth/registrationStepTwoProfilPictureManager.js') }}" defer></script>
{% endblock %}

{% block body %}

    <section class="brand-panel">
        <div class="content brand-logo">
            <svg viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg">
                <path d="M22 14c-5-6-14-4-14 3 0 9 14 13 14 13s14-4 14-13c0-7-9-9-14-3z" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M22 30 C22 42, 12 42, 8 48 C4 54, 30 54, 42 48 C54 42, 60 30, 74 32" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
            </svg>

            <span>Famille Jean</span>
        </div>

        <div class="brand-quote">
            <p>&laquo; Bien-aimés, aimons-nous les uns les autres ; car l'amour est de Dieu. &raquo;</p>
            <div class="ref">1 Jean 4:7</div>
        </div>

        <div class="brand-foot">Impact Centre Chrétien &mdash; Deux Plateaux, Abidjan</div>
    </section>


    <section class="form-container">

        <div class="form-content">
            <div class="stepper">

                <div class="step">
                    <div class="step-dot done">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 6L9 17l-5-5"/>
                        </svg>
                    </div>

                    <span class="step-label">Identité</span>
                </div>

                <div class="step-line"></div>

                <div class="step">
                    <div class="step-dot active">2</div>
                    <span class="step-label">Compte</span>
                </div>
            </div>

            <span class="eyebrow --middle">Rejoindre la famille</span>
            <h1 class="--middle">Finaliser votre adhesion</h1>
            <p class="sub --middle">Choisis tes identifiants de connexion et, si tu le souhaites, une photo pour l'annuaire.</p>

            {{ form_start(registration_step_two_form) }}

                <div class="field">
                    {{ form_label(registration_step_two_form.pseudonyme) }}
                    {{ form_widget(registration_step_two_form.pseudonyme) }}
                    {{ form_errors(registration_step_two_form.pseudonyme) }}
                </div>

                <div class="field">
                    {{ form_label(registration_step_two_form.password) }}

                    <div class="field-password-wrapper">
                        {{ form_widget(registration_step_two_form.password) }}

                        <button type="button" class="btn-toggle-password js-toggle-password" aria-label="Afficher le mot de passe" aria-pressed="false">
                            <svg class="js-eye-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>

                    {{ form_errors(registration_step_two_form.password) }}
                </div>

                <div class="profil-pic-field">
                    {{ form_label(registration_step_two_form.profilePicture) }}
                    {{ form_widget(registration_step_two_form.profilePicture) }}

                    {# default zone #}
                    <div class="input-file-wrapper js-upload-zone">
                        <div class="icon-wrapper">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                <path d="M17 8l-5-5-5 5"/>
                                <path d="M12 3v12"/>
                            </svg>
                        </div>

                        <div>
                            <div class="main-txt">Choisir un fichier</div>
                            <div class="sub-txt">JPG, JPEG, WEBP ou PNG, 2 Mo max</div>
                        </div>
                    </div>

                    {# preview zone #}
                    <div class="file-preview-wrapper js-preview-zone" style="display: none;">
                        <div class="preview-info">
                            <img class="js-preview-img" src="" alt="Aperçu de la photo de profil">

                            <div class="file-details">
                                <span class="file-name js-file-name"></span>
                                <span class="file-size js-file-size"></span>
                            </div>
                        </div>

                        <button type="button" class="btn-remove-file js-btn-remove" aria-label="Retirer la photo" title="Retirer la photo">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>

                    {{ form_errors(registration_step_two_form.profilePicture) }}
                </div>

                <button type="submit" class="submit-btn">
                    Devenir membre

                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path d="M20 6L9 17l-5-5"/>
                    </svg>
                </button>

            {{ form_end(registration_step_two_form) }}
        </div>

    </section>

{% endblock %}
