{% extends 'base.html.twig' %}

{% block title %}Famille Jean - ICC Deux Plateaux | Devenir membre{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('style/css-prefixed/member/registerAndAuth/registrationStepOne.css') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,500&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}

    <section class="brand-panel">
        <div class="content brand-logo">
            <svg viewBox="0 0 100 60" xmlns="http://www.w3.org/2000/svg">
                <path d="M22 14c-5-6-14-4-14 3 0 9 14 13 14 13s14-4 14-13c0-7-9-9-14-3z" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M22 30 C22 42, 12 42, 8 48 C4 54, 30 54, 42 48 C54 42, 60 30, 74 32" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
            </svg>

            <span>Famille Jean</span>
        </div>

        <div class="brand-quote">
            <p>&laquo; Bien-aimés, aimons-nous les uns les autres ; car l'amour est de Dieu. &raquo;</p>
            <div class="ref">1 Jean 4:7</div>
        </div>

        <div class="brand-foot">Impact Centre Chrétien &mdash; Deux Plateaux, Abidjan</div>
    </section>


    <section class="form-container">
        <div class="form-content">
            <div class="stepper">

                <div class="step">
                    <div class="step-dot active">1</div>
                    <span class="step-label">Identité</span>
                </div>

                <div class="step-line"></div>

                <div class="step">
                    <div class="step-dot upcoming">2</div>
                    <span class="step-label dim">Compte</span>
                </div>
            </div>

            <span class="eyebrow --middle">Rejoindre la famille</span>
            <h1 class="--middle">Devenir membre</h1>
            <p class="sub --middle">Commençons par faire connaissance. Ces informations apparaîtront dans l'annuaire de la famille.</p>

            {{ form_start(registration_step_one_form) }}

                <div class="field">
                    {{ form_label(registration_step_one_form.lastName) }}
                    {{ form_widget(registration_step_one_form.lastName) }}
                    {{ form_errors(registration_step_one_form.lastName) }}
                </div>

                <div class="field">
                    {{ form_label(registration_step_one_form.firstName) }}
                    {{ form_widget(registration_step_one_form.firstName) }}
                    {{ form_errors(registration_step_one_form.firstName) }}
                </div>

                <button type="submit" class="submit-btn">
                    Continuer

                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path d="M5 12h14M13 6l6 6-6 6"/>
                    </svg>
                </button>
            {{ form_end(registration_step_one_form) }}

            <div class="section-footer">Déjà membre ? <a href="{{ path('member_login') }}">Se connecter</a></div>
        </div>
    </section>

{% endblock %}
